# Browser-safe Supabase settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Set this to the canonical HTTPS domain in Vercel Production.
# For Vercel Preview, omit it to use NEXT_PUBLIC_VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PRAXIZ AI / Ollama (server-only; never prefix these with NEXT_PUBLIC_)
# Local development example: http://localhost:11434
# Hosted deployments must use an HTTPS endpoint reachable from the server runtime.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# Optional automatic contact-form delivery through Resend.
# Optional notification email; contact submissions are delivered to the protected inbox without it.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
