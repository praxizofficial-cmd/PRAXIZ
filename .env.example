# Browser-safe Supabase settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Set this to the canonical HTTPS domain in Vercel Production.
# For Vercel Preview, omit it to use NEXT_PUBLIC_VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
